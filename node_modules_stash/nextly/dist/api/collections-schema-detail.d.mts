 * ```typescript
 * // In your Next.js app: app/api/collections/schema/[slug]/route.ts
 * export { GET, PATCH, DELETE } from 'nextly/api/collections-schema-detail';
 * ```
 *
 * @module api/collections-schema-detail
 */
