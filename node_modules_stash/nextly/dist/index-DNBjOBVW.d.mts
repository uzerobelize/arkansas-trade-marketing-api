 *
 * @example
 * ```typescript
 * const admin: CollectionAdminOptions = {
 *   group: 'Content',
 *   icon: 'FileText',
 *   useAsTitle: 'title',
 *   pagination: {
 *     defaultLimit: 25,
 *   },
 * };
 * ```
 *
 * @example Custom edit view
 * ```typescript
 * const admin: CollectionAdminOptions = {
 *   group: 'Forms',
 *   useAsTitle: 'name',
 *   components: {
 *     views: {
 *       Edit: {
 *         Component: "@nextlyhq/plugin-form-builder/admin#FormBuilderView",
 *       },
 *     },
 *   },
 * };
 * ```
 */
