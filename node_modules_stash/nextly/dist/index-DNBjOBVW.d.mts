 * @example
 * ```typescript
 * const PostsConfig: CollectionConfig = {
 *   slug: 'posts',
 *   labels: {
 *     singular: 'Post',
 *     plural: 'Posts',
 *   },
 *   fields: [
 *     { type: 'text', name: 'title', required: true },
 *     { type: 'textarea', name: 'content' },
 *     { type: 'select', name: 'status', options: [
 *       { label: 'Draft', value: 'draft' },
 *       { label: 'Published', value: 'published' },
 *     ]},
 *   ],
 *   timestamps: true,
 *   admin: {
 *     group: 'Content',
 *     useAsTitle: 'title',
