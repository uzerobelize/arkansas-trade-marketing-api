            },
            {
              "admin": {
                "description": "Form field configuration. Managed by the Form Builder UI."
              },
              "defaultValue": [],
              "label": "Form Fields",
              "name": "fields",
              "required": true,
              "type": "json"
            },
            {
              "fields": [
                {
                  "admin": {
                    "description": "Text displayed on the form submit button"
                  },
                  "defaultValue": "Submit",
                  "label": "Submit Button Text",
                  "name": "submitButtonText",
                  "type": "text"
                },
                {
                  "admin": {
                    "description": "What happens after a successful form submission"
                  },
                  "defaultValue": "message",
                  "label": "After Submission",
                  "name": "confirmationType",
                  "options": [
                    {
                      "label": "Show Message",
                      "value": "message"
                    },
                    {
                      "label": "Redirect to URL",
                      "value": "redirect"
                    }
                  ],
                  "type": "select"
                },
                {
                  "admin": {
                    "condition": {
                      "equals": "message",
                      "field": "settings.confirmationType"
                    },
                    "description": "Message shown after successful submission"
                  },
                  "defaultValue": "Thank you for your submission!",
                  "label": "Success Message",
                  "name": "successMessage",
                  "type": "textarea"
                },
                {
                  "admin": {
                    "condition": {
                      "equals": "redirect",
                      "field": "settings.confirmationType"
                    },
                    "description": "URL to redirect to after submission"
                  },
                  "label": "Redirect URL",
                  "name": "redirectUrl",
                  "type": "text"
                },
                {
                  "admin": {
                    "description": "Allow the same user/IP to submit this form multiple times"
                  },
                  "defaultValue": true,
                  "label": "Allow Multiple Submissions",
                  "name": "allowMultipleSubmissions",
                  "type": "checkbox"
                },
                {
                  "admin": {
                    "description": "Per-form honeypot override; unset inherits the plugin default"
                  },
                  "label": "Honeypot",
                  "name": "honeypotEnabled",
                  "type": "checkbox"
                },
                {
                  "admin": {
                    "description": "Per-form reCAPTCHA override; unset inherits the plugin default"
                  },
                  "label": "Enable reCAPTCHA",
                  "name": "captchaEnabled",
                  "type": "checkbox"
                },
                {
                  "admin": {
                    "condition": {
                      "equals": true,
                      "field": "settings.captchaEnabled"
                    },
                    "description": "Override the default reCAPTCHA site key for this form"
                  },
                  "label": "reCAPTCHA Site Key",
                  "name": "captchaSiteKey",
                  "type": "text"
                }
              ],
              "label": "Form Settings",
              "name": "settings",
              "type": "group"
            },
            {
              "admin": {
                "description": "Email notification rules. Managed by the Form Builder UI."
              },
              "defaultValue": [],
              "label": "Notifications",
              "name": "notifications",
              "type": "json"
            },
            {
              "admin": {
                "description": "Only published forms can receive submissions. Closed forms display a message instead."
              },
              "defaultValue": "draft",
              "label": "Status",
              "name": "status",
              "options": [
                {
                  "label": "Draft",
                  "value": "draft"
                },
                {
                  "label": "Published",
                  "value": "published"
                },
                {
                  "label": "Closed",
                  "value": "closed"
                }
              ],
              "required": true,
              "type": "select"
            },
            {
              "admin": {
                "description": "When this form first went live. Written once and never changed.",
                "readOnly": true
              },
              "label": "First Published",
              "name": "wentLiveAt",
              "type": "date"
            },
            {
              "admin": {
                "condition": {
                  "equals": "closed",
                  "field": "status"
                },
                "description": "Message shown when form status is 'closed'"
              },
              "defaultValue": "This form is no longer accepting submissions.",
              "label": "Closed Form Message",
              "name": "closedMessage",
              "type": "textarea"
            }
          ],
          "labels": {
            "plural": "Forms",
            "singular": "Form"
          },
