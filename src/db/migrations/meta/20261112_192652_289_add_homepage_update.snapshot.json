              "relationTo": "forms",
              "required": true,
              "type": "relationship"
            },
            {
              "admin": {
                "description": "The submitted form data as JSON",
                "readOnly": true
              },
              "label": "Submission Data",
              "name": "data",
              "required": true,
              "type": "json"
            },
            {
              "admin": {
                "description": "Track whether this submission has been reviewed"
              },
              "defaultValue": "new",
              "index": true,
              "label": "Status",
              "name": "status",
              "options": [
                {
                  "label": "New",
                  "value": "new"
                },
                {
                  "label": "Read",
                  "value": "read"
                },
                {
                  "label": "Archived",
                  "value": "archived"
                },
                {
                  "label": "Spam",
                  "value": "spam"
                }
              ],
              "required": true,
              "type": "select"
            },
            {
              "admin": {
                "description": "Which spam check flagged this submission (empty for clean submissions)",
                "readOnly": true
              },
              "label": "Spam Reason",
              "name": "spamReason",
              "type": "text"
            },
            {
              "admin": {
                "description": "Notes visible only to admins (not shown to submitter)"
              },
              "label": "Internal Notes",
              "name": "notes",
              "type": "textarea"
            },
            {
              "admin": {
                "description": "IP address of the submitter",
                "readOnly": true
              },
              "label": "IP Address",
              "name": "ipAddress",
              "type": "text"
            },
            {
              "admin": {
                "description": "Browser/device information of the submitter",
                "readOnly": true
              },
              "label": "User Agent",
              "name": "userAgent",
              "type": "text"
            },
            {
              "admin": {
                "description": "When the form was submitted",
                "readOnly": true
              },
              "index": true,
              "label": "Submitted At",
              "name": "submittedAt",
              "required": true,
              "type": "date"
            },
            {
              "admin": {
                "description": "When an admin last edited the submitted data",
                "readOnly": true
              },
              "label": "Edited At",
              "name": "editedAt",
              "type": "date"
            },
            {
              "admin": {
                "description": "ID of the admin who last edited the submitted data",
                "readOnly": true
              },
              "label": "Edited By",
              "name": "editedBy",
              "type": "text"
            }
          ],
